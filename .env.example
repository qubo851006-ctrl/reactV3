# ─────────────────────────────────────────────────────────────────
# ReactV3 environment template
# Copy to backend/.env and fill in real values. NEVER commit .env.
# ─────────────────────────────────────────────────────────────────

# ── LLM Models (defaults match V2 behavior) ──────────────────────
MODEL_CHAT=qwen2.5-72b
MODEL_INTENT=qwen2.5-72b
MODEL_VISION=qwen2.5-vl-72b
MODEL_CLASSIFY=qwen2.5-72b   # used by utils/classifier.py (training category)

# Comma-separated model whitelist exposed to UI
AI_CHAT_MODELS=qwen2.5-72b,DeepSeek-V3,glm-5-outside
AI_VISION_MODELS=qwen2.5-vl-72b

# ── AirChina LLM Gateway ─────────────────────────────────────────
AIRCHINA_API_KEY=<your-airchina-api-key>
AIRCHINA_BASE_URL=<https://your-airchina-endpoint/v1>
AI_HTTP_HOST_HEADER=
AI_HTTP_VERIFY_SSL=true

# ── Knowledge Base (Zhishu/Dify) ─────────────────────────────────
ZHISHU_API_KEY=<your-zhishu-api-key>
ZHISHU_BASE_URL=<https://your-zhishu-endpoint/v1>

# ── 企查查 ────────────────────────────────────────────────────────
QCC_TOKEN=<your-qcc-token>

# ── Ollama (optional local fallback) ─────────────────────────────
OLLAMA_BASE_URL=
OLLAMA_API_KEY=ollama

# DingTalk group notification (optional, disabled by default)
DINGTALK_NOTIFY_ENABLED=false
DINGTALK_NOTIFY_ON_SUCCESS=true
DINGTALK_NOTIFY_ON_FAILURE=true
DINGTALK_NOTIFY_ON_WARNING=true
DINGTALK_NOTIFY_MENTION_USER=true
DINGTALK_WEBHOOK_URL=
DINGTALK_WEBHOOK_SECRET=
DINGTALK_NOTIFY_BASE_URL=https://192.168.9.226:8443
DINGTALK_NOTIFY_TIMEOUT_SECONDS=2
DINGTALK_ENTERPRISE_ENABLED=false
DINGTALK_WORK_NOTICE_ENABLED=false
DINGTALK_ORG_SYNC_ENABLED=false
DINGTALK_CORP_ID=
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_AGENT_ID=
DINGTALK_ORG_SYNC_ROOT_DEPT_ID=1
DINGTALK_ORG_SYNC_CREATE_USERS=false
DINGTALK_SSO_ENABLED=false

# ── OCR concurrency / breaker tuning ─────────────────────────────
LEDGER_DOC_CONCURRENCY=3
LEDGER_LLM_CONCURRENCY=3
LEDGER_OCR_CONCURRENCY=2
AIRCHINA_OCR_TIMEOUT_SECONDS=12
AIRCHINA_OCR_FAILURE_THRESHOLD=3
AIRCHINA_OCR_BREAKER_SECONDS=90
AIRCHINA_OCR_CHANNEL=25

# ─────────────────────────────────────────────────────────────────
# V3 main database — PostgreSQL recommended for server deployment.
# Leave blank for local development; backend falls back to data/auth.db SQLite.
# ─────────────────────────────────────────────────────────────────
APP_DATABASE_URL=postgresql://<user>:<password>@<host>:5432/reactv3
# Optional shared fallback. APP_DATABASE_URL takes precedence for the main DB.
DATABASE_URL=
# Optional override for the LLM audit DB. Leave blank to reuse DATABASE_URL.
LLM_AUDIT_DATABASE_URL=
DB_HOST=<your-db-host>
DB_PORT=5432
DB_NAME=reactv3
DB_USER=<your-db-user>
DB_PASSWORD=<your-db-password>

# ─────────────────────────────────────────────────────────────────
# Security / session
# ─────────────────────────────────────────────────────────────────
# Set true when serving over HTTPS so the session cookie gets the Secure flag.
SESSION_COOKIE_SECURE=false
# Rate-limit login attempts per (user_id, ip) — N failures inside the window
# triggers a 429.
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=300

# ─────────────────────────────────────────────────────────────────
# Upload size caps (bytes) — defaults already applied in upload_validation.py
# ─────────────────────────────────────────────────────────────────
UPLOAD_PDF_MAX_BYTES=
UPLOAD_IMAGE_MAX_BYTES=
UPLOAD_EXCEL_MAX_BYTES=
# Legal document uploads (ledger flow) — usually larger than the generic cap
LEGAL_UPLOAD_MAX_BYTES=
