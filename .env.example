# ─────────────────────────────────────────────────────────────────
# ReactV3 environment template
# Copy to backend/.env and fill in real values. NEVER commit .env.
# ─────────────────────────────────────────────────────────────────

# ── LLM Models (defaults match V2 behavior) ──────────────────────
MODEL_CHAT=qwen2.5-72b
MODEL_INTENT=qwen2.5-72b
MODEL_VISION=qwen2.5-vl-72b

# Comma-separated model whitelist exposed to UI
AI_CHAT_MODELS=qwen2.5-72b,DeepSeek-V3,glm-5-outside
AI_VISION_MODELS=qwen2.5-vl-72b

# ── AirChina LLM Gateway ─────────────────────────────────────────
AIRCHINA_API_KEY=<your-airchina-api-key>
AIRCHINA_BASE_URL=<https://your-airchina-endpoint/v1>
AI_HTTP_HOST_HEADER=
AI_HTTP_VERIFY_SSL=true

# ── Knowledge Base (Zhishu/Dify) ─────────────────────────────────
ZHISHU_API_KEY=<your-zhishu-api-key>
ZHISHU_BASE_URL=<https://your-zhishu-endpoint/v1>

# ── 企查查 ────────────────────────────────────────────────────────
QCC_TOKEN=<your-qcc-token>

# ── Ollama (optional local fallback) ─────────────────────────────
OLLAMA_BASE_URL=
OLLAMA_API_KEY=ollama

# ── OCR concurrency / breaker tuning ─────────────────────────────
LEDGER_DOC_CONCURRENCY=3
LEDGER_LLM_CONCURRENCY=3
LEDGER_OCR_CONCURRENCY=2
AIRCHINA_OCR_TIMEOUT_SECONDS=12
AIRCHINA_OCR_FAILURE_THRESHOLD=3
AIRCHINA_OCR_BREAKER_SECONDS=90
AIRCHINA_OCR_CHANNEL=25

# ─────────────────────────────────────────────────────────────────
# V3 NEW — PostgreSQL (P0-1 in roadmap)
# Backend code does not consume this yet; reserved for upcoming
# migration from JSON files to a real database.
# ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<dbname>
DB_HOST=<your-db-host>
DB_PORT=5432
DB_NAME=reactv3
DB_USER=<your-db-user>
DB_PASSWORD=<your-db-password>
